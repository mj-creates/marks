# ─────────────────────────────────────────────────────────────────────────
# Faculty Marks Portal — environment configuration
# Copy this file to ".env" and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────

# IP or hostname of the college portal (no https://, no trailing slash)
PORTAL_BASE_HOST=192.168.10.10

# ── Optional (defaults shown) ─────────────────────────────────────────────

# Login form POST path (relative to each semester sub-site)
PORTAL_LOGIN_PATH=/login.jsp

# Form field names used by the login page (confirmed from portal HTML)
PORTAL_LOGIN_USER_FIELD=user
PORTAL_LOGIN_PASS_FIELD=pwd

# SSL certificate verification
# Set to false for internal portals with self-signed certificates (like 192.168.x.x)
PORTAL_VERIFY_SSL=false
