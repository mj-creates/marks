# ─────────────────────────────────────────────────────────────────────────
# Faculty Marks Portal — environment configuration
# Copy this file to ".env" and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────

# IP or hostname of the college portal (no https://, no trailing slash)
PORTAL_BASE_HOST=192.168.10.10

# Your faculty login credentials
PORTAL_USERNAME=your_username_here
PORTAL_PASSWORD=your_password_here

# ── Optional (defaults shown) ─────────────────────────────────────────────

# Login form POST path (relative to each semester sub-site)
# Default works for standard JSP / j_security_check portals
PORTAL_LOGIN_PATH=/j_security_check

# Form field names used by the login page
PORTAL_LOGIN_USER_FIELD=j_username
PORTAL_LOGIN_PASS_FIELD=j_password

# SSL certificate verification
# Set to false for internal portals with self-signed certificates (like 192.168.x.x)
PORTAL_VERIFY_SSL=false

# Earliest batch year to show in the dropdown
PORTAL_BATCH_START_YEAR=2018
